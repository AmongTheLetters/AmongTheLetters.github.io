# Copy to .env.local for local builds. GitHub Actions reads the same names from repository Variables.
# Public values only. Never put a Supabase service role key, Stripe secret key or Brevo key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_STRIPE_LINK_MONTHLY=
VITE_STRIPE_LINK_ANNUAL=
VITE_STRIPE_LINK_LIFETIME=
VITE_STRIPE_PORTAL=
VITE_GOOGLE_SIGNIN=off
VITE_VAPID_PUBLIC_KEY=
# VITE_PREVIEW=1   pretend accounts for review builds only
