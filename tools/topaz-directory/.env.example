# Optional keys for the Topaz Pages crawler.
# If you already made a .env for the Jade Pages crawler (tools\reading-directory\.env), its keys are used
# automatically and you can skip this. Otherwise
# 1. Make a copy of this file named  .env  (in this same folder).
# 2. Paste a key after the = sign. Leave a line empty to skip that source.
# The .env file stays on your computer. It is never uploaded to GitHub.

# Gemini API (free, from Google AI Studio): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Leave as auto to pick the newest free Flash-Lite model automatically.
GEMINI_MODEL=auto
# Stay under the free limits (check yours at https://aistudio.google.com/rate-limit).
GEMINI_DAILY_LIMIT=200
GEMINI_RPM=8

# Marginalia Search (free non-commercial key, ask by email: contact@marginalia-search.com)
MARGINALIA_API_KEY=

# Brave Search API (not recommended for now, see README)
BRAVE_API_KEY=
BRAVE_MONTHLY_LIMIT=900
